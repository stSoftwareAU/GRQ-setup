<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  NOTE: This is a TEMPLATE file. The actual daemon plist is generated dynamically
  by setup.sh and add-user.sh scripts based on the user's actual
  home directory (which may be on a removable drive like /Volumes/GRQ/Username).
  
  The daemon runs a script named after the user (e.g., elephant.sh for user 'elephant').
  
  Do NOT install this file directly. Use the setup scripts instead.
-->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lecklogic.usertask</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/username/GRQ/username.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Nice</key>
    <integer>20</integer> <!-- Low CPU priority for heavy disk I/O tasks -->
    <key>UserName</key>
    <string>username</string>
    <key>WorkingDirectory</key>
    <string>/Users/username</string>
    <key>StandardOutPath</key>
    <string>/Users/username/logs/username.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/username/logs/username.err</string>
</dict>
</plist>
