<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lecklogic.highprioritytask</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rocket/GRQ/rocket.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Nice</key>
    <integer>-20</integer> <!-- Highest CPU priority -->
    <key>UserName</key>
    <string>rocket</string>
    <key>WorkingDirectory</key>
    <string>/Users/rocket</string>
    <key>StandardOutPath</key>
    <string>/Users/rocket/logs/rocket.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rocket/logs/rocket.err.log</string>
</dict>
</plist>
