<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lecklogic.lowprioritytask</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sloth/src/GRQ/sloth.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>20</integer> <!-- Lowest CPU priority -->
    <key>UserName</key>
    <string>sloth</string>
    <key>WorkingDirectory</key>
    <string>/Users/sloth</string>
    <key>StandardOutPath</key>
    <string>/Users/sloth/logs/sloth.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sloth/logs/sloth.err.log</string>
</dict>
</plist>
